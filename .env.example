# Gemini — server-side only. The UI never sees this.
GEMINI_API_KEY=

# Model IDs. GEMINI_LIVE_MODEL is the bidirectional audio model (the user's "Gemini 3.1 Flash Live"
# — confirm the exact public ID at coding time; examples: gemini-live-2.5-flash-preview).
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Local Stagehand runtime
AGENT_WS_PORT=7777

# Browser-visible: how the UI reaches the local runtime. For all-local dev, leave as-is.
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:7777

# Optional shared secret for tunneled setups (v2). Leave empty for local-only.
AGENT_SHARED_SECRET=

# ---- Supabase (auth + DB + KB storage) ----
# Project URL and anon key from Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Knowledge base ----
# Gemini embeddings model used for KB chunks and live retrieval queries.
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Per-file upload cap (MB) and chunking parameters.
KB_MAX_UPLOAD_MB=25
KB_CHUNK_TOKENS=500
KB_CHUNK_OVERLAP=50
# Set to 1 to enable live RAG injection during Q&A. 0 = discover-time grounding only.
NEXT_PUBLIC_ENABLE_LIVE_RAG=1
